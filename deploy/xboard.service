[Unit]
Description=Xboard (Go)
After=network-online.target mysql.service mariadb.service redis-server.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=xboard
Group=xboard
WorkingDirectory=/opt/xboard
EnvironmentFile=/opt/xboard/.env
ExecStart=/opt/xboard/xboard serve
Restart=always
RestartSec=3
# 优雅退出：收到 SIGTERM 后最多 10 秒处理在途请求
TimeoutStopSec=15
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/xboard

[Install]
WantedBy=multi-user.target
