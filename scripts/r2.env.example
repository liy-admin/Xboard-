# Cloudflare R2 上传配置样例。复制为 scripts/.r2.env 后填写（该文件已被 .gitignore 忽略，不要提交）。
# 也可以不建文件，直接用同名环境变量。
#
# Access Key ID / Secret Access Key 在 Cloudflare 控制台创建：
#   R2 → 管理 R2 API 令牌 → 创建 API 令牌（权限选「对象读和写」，可限定到这一个桶）。
# Secret Access Key 只在创建时显示一次，丢了需要重新生成。

# 账号 ID：端点就是 https://<账号ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# 桶名（在 R2 控制台里看到的 Bucket 名称）
R2_BUCKET=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 可选：桶内目录，缺省 xboard。留空（R2_PREFIX=）表示放在桶根目录。
# R2_PREFIX=xboard
