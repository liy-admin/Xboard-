# Xboard (Go) 运行配置。复制为 .env 并按需修改；与 PHP 版使用同样的变量名，可原地替换。
# 真实的环境变量优先于本文件。

# ---- 监听 ----
# 直接对外提供服务用 0.0.0.0:7001；放在 nginx 后面建议 127.0.0.1:7001
LISTEN=127.0.0.1:7001

# ---- 应用 ----
# 必填。执行 `./xboard keygen` 生成。后台默认路径（crc32b）、加密订阅密钥等依赖它，
# 更换 APP_KEY 会使默认后台路径与已签发的加密订阅链接失效。
APP_KEY=
# 时区（日界、统计、定时任务按此计算）；与 PHP 的 config/app.php 一致，缺省 Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai

# ---- 数据库（MySQL 5.7+/8.x 或 MariaDB 10.4+；不支持 SQLite / PostgreSQL）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xboard
DB_USERNAME=xboard
DB_PASSWORD=

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 可选 ----
# 反向代理的地址 / 网段（逗号分隔）；只有来自这些地址的请求才会采信 X-Forwarded-For。
# 缺省：127.0.0.1,::1 以及内网网段
# TRUSTED_PROXIES=127.0.0.1,::1
# 关闭内置调度器（多实例部署时只在一台机器上保留调度器）
# XBOARD_SCHEDULER=0
# 磁盘覆盖目录：存在时优先于二进制内嵌的前端资源
# XBOARD_PUBLIC_DIR=public
# XBOARD_THEME_DIR=theme
# XBOARD_PLUGINS_DIR=plugins-core,plugins
# 调试：1 = gin 调试日志 / 打印全部 SQL
# XBOARD_DEBUG=0
# XBOARD_SQL_DEBUG=0
